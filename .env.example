COMPOSE_PROJECT_NAME=karewa_api

# App
APP_ENV=local

# Nginx
NGINX_HOST_PORT=8080

# MariaDB
DB_HOST=db
DB_PORT=3306
DB_HOST_PORT=3306
DB_DATABASE=karewa
DB_USERNAME=karewa_user
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_root_password

# Mailpit
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# Cloudflared (named tunnel, JSON credentials mode)
# create_new flow values:
# CLOUDFLARED_TUNNEL_ID=<generated_uuid>
# CLOUDFLARED_HOSTNAME=kapi.chavodigital.com
# CLOUDFLARED_CREDENTIALS_FILE=/etc/cloudflared/<generated_uuid>.json
# CLOUDFLARED_HOST_CREDENTIALS_PATH=/home/<user>/.cloudflared/<generated_uuid>.json
CLOUDFLARED_TUNNEL_NAME=karewa_api
CLOUDFLARED_TUNNEL_ID=replace_with_tunnel_id
CLOUDFLARED_HOSTNAME=kapi.chavodigital.com
CLOUDFLARED_CREDENTIALS_FILE=/etc/cloudflared/${CLOUDFLARED_TUNNEL_ID}.json
CLOUDFLARED_HOST_CREDENTIALS_PATH=/home/your-user/.cloudflared/${CLOUDFLARED_TUNNEL_ID}.json
CLOUDFLARED_TARGET_SERVICE=http://nginx:80
